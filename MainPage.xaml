<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CameraCaptureHangRepro.MainPage">
    <Grid RowDefinitions="Auto,*,200">
        <Button x:Name="RunBtn" Text="Run start/capture/stop loop" Clicked="OnRunClicked" />
        <toolkit:CameraView x:Name="cameraView" Grid.Row="1" />
        <Editor x:Name="LogBox" Grid.Row="2" IsReadOnly="True" />
    </Grid>
</ContentPage>
